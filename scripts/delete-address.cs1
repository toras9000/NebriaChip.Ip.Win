#!/usr/bin/env -S dotnet run --file
#:property TargetFramework=net10.0-windows7.0
#:project ../src/NebriaChip.Ip.Win.csproj
#:package ConsoleAppFramework@5.7.13
#:package Lestaly@0.143.0
using System.Net;
using ConsoleAppFramework;
using Lestaly;
using NebriaChip.Ip.Win;

await ConsoleApp.RunAsync(args, async (
    string adapter,
    string address,
    int prefix,
    string? errorFile = default,
    CancellationToken signal = default
) => await Paved.RunAsync(async () =>
{
    var addr = IPAddress.Parse(address);

    Console.WriteLine($"Delete Address: [{adapter}] {addr}/{prefix}");
    var addrOperator = new WinIpAddrOperator();
    addrOperator.DeleteUnicastAddress(adapter, addr, prefix);
}));
